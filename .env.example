# AlgoTraders local configuration template.
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored (.gitignore:118); this template is tracked and must never
# contain a real credential.
#
#   cp .env.example .env.local
#
# Nothing loads this file automatically. The library reads os.getenv and
# never touches the filesystem for configuration, because a server-side
# host supplies credentials through its own secret manager rather than a
# dotfile. Load it yourself when you need it:
#
#   bash        set -a; source .env.local; set +a
#   powershell  Get-Content .env.local | ForEach-Object {
#                 if ($_ -match '^\s*([^#=]+)=(.*)$') {
#                   [Environment]::SetEnvironmentVariable(
#                     $matches[1].Trim(), $matches[2].Trim(), 'Process') } }
#
# Tests marked `live` load `.env.local` on their own, see tests/conftest.py.
# Every other test runs against scrubbed, throwaway values and cannot read
# this file.

# ---------------------------------------------------------------------
# Fyers API v3 - https://myapi.fyers.in/dashboard
# ---------------------------------------------------------------------
# CLIENT_ID is the app id shown in the API dashboard, ending in "-100".
# SECRET_KEY is the app secret, not your DEMAT account password.
# REDIRECT_URL must byte-for-byte match the URI registered on the app.
# PIN is the 4 digit trading PIN, required only by the refresh flow.
ALGOTRADERS_FYERS_CLIENT_ID=XXXXXXXXXX-100
ALGOTRADERS_FYERS_SECRET_KEY=replace-with-your-fyers-app-secret
ALGOTRADERS_FYERS_REDIRECT_URL=http://127.0.0.1:8000/api/brokers/fyers/callback
ALGOTRADERS_FYERS_PIN=0000

# ---------------------------------------------------------------------
# Zerodha Kite Connect v3 - https://developers.kite.trade/apps
# ---------------------------------------------------------------------
# Kite has no usable refresh flow, so the access token must be re-minted
# through an interactive login every day after it expires at 06:00 IST.
# Historical data is a paid add-on and is billed separately.
ALGOTRADERS_KITE_API_KEY=replace-with-your-kite-api-key
ALGOTRADERS_KITE_API_SECRET=replace-with-your-kite-api-secret
ALGOTRADERS_KITE_REDIRECT_URL=http://127.0.0.1:8000/api/brokers/kite/callback

# ---------------------------------------------------------------------
# Runtime directories
# ---------------------------------------------------------------------
# TOKEN_DIR holds the daily session tokens written by FileTokenStore.
# That store is a development convenience only: it is split brain under
# multi-worker uvicorn, and on Windows the 0600 mode does not restrict
# other users. Production hosts implement BaseTokenStore over Postgres.
#
# LOG_DIR must be set, otherwise the Fyers SDK writes fyersApi.log into
# whatever the working directory happens to be.
ALGOTRADERS_TOKEN_DIR=.algotraders/tokens
ALGOTRADERS_CACHE_DIR=.algotraders/cache
ALGOTRADERS_LOG_DIR=.algotraders/logs
